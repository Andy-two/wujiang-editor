{
  "guan_yu": {
    "general": "关羽",
    "weapon": "青龙偃月刀",
    "skills": [
      {
        "level": 11,
        "target": "青龙斩月",
        "keys": [
          "guan_qinglong"
        ],
        "text": "丰富击杀与未击杀两种场景下的附加收益。 击杀敌方单位时，在原有技能冷却缩减效果基础上，追加自身后续攻击伤害增幅效果； 未击杀敌方单位时，在原有缴械控制效果基础上，追加自身物伤降低，并额外为目标附加「眩晕」。",
        "fx": []
      },
      {
        "level": 14,
        "target": "千里单骑",
        "keys": [
          "qianli"
        ],
        "text": "自身1圈范围内没有其他我方部队时防御穿透提升。 行动开始时获取1层「武魂」；获得「武魂」到达上限，额外回复兵力并解除1个控制，显著提升角色持续作战容错率。",
        "fx": []
      },
      {
        "level": 17,
        "target": "威震华夏",
        "keys": [
          "guan_weizhen"
        ],
        "text": "提升技策射程，并新增移动联动增益机制。 关羽可以根据自身移动距离，提升防御穿透能力。如此，可在策略走位的同时，强化群体作战能力。",
        "fx": []
      }
    ],
    "talent": [
      {
        "level": 20,
        "target": "武圣",
        "key": "wusheng",
        "text": "缩减天赋触发冷却间隔，将原有「拖刀计」替换为效果更强的「回马刀」。 未处于「回马刀」状态时，自身主动攻击稳定触发暴击。 「回马刀」状态下，反击时必定暴击和先攻，且伤害和反击射程将得到提升。该状态无法被驱散，将极大强化角色反制作战能力。",
        "fx": []
      }
    ],
    "source": ""
  },
  "xu_chu": {
